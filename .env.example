# Copy to .env and adjust. All values have sensible defaults in src/config.ts.

# TCP port the API listens on
PORT=3000
# Bind address — 0.0.0.0 so the container is reachable inside the pod network
HOST=0.0.0.0
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# GitHub PAT with write:packages + read:packages (needed for GHCR push/pull)
GITHUB_PAT=
